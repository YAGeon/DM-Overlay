{
  "name": "discord-dm-overlay",
  "version": "1.11.0",
  "private": true,
  "description": "Мини-окно на экране ПК с личными сообщениями Discord и Telegram",
  "author": "DM Overlay",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
